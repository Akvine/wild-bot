<configuration>

    <!-- Appenders -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%replace(%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - [%X{username}] [%X{chatId}] [%X{botType}] %msg%n){' ?\[\]', ''}</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH:-log}/wild-tg-bot.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH:-log}/wild-tg-bot.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>5</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%replace(%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - [%X{username}] [%X{chatId}] [%X{botType}] %msg%n){' ?\[\]', ''}</pattern>
        </encoder>
    </appender>

    <appender name="SLOW_QUERY_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH:-log}/slow-queries.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH:-log}/slow-queries.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>5</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %msg%n</pattern>
        </encoder>
    </appender>

    <!-- HTTP-запросы и ответы (InfrastructureBeansConfig#httpLoggingFilter) - отдельный файл, а не общий лог -->
    <appender name="HTTP_LOG_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH:-log}/http.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH:-log}/http.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>5</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Статистика по эндпоинтам (InfrastructureBeansConfig#apiStatisticsPrinter) - отдельный файл -->
    <appender name="API_STATISTICS_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH:-log}/api-statistics.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH:-log}/api-statistics.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>5</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Метрики работы с БД: коммиты (InfrastructureBeansConfig#dbMetricsListener) - отдельный файл -->
    <appender name="DB_METRICS_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH:-log}/db-metrics.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH:-log}/db-metrics.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>5</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Root Logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

    <logger name="ru.akvine.wild.bot.monitoring.SlowQuery" level="WARN" additivity="false">
        <appender-ref ref="SLOW_QUERY_FILE"/>
    </logger>

    <logger name="ru.akvine.wild.bot.monitoring.DbMetrics" level="INFO" additivity="false">
        <appender-ref ref="DB_METRICS_FILE"/>
    </logger>

    <logger name="ru.akvine.wild.bot.httplogging" level="INFO" additivity="false">
        <appender-ref ref="HTTP_LOG_FILE"/>
    </logger>

    <logger name="ru.akvine.wild.bot.monitoring.ApiStatistics" level="INFO" additivity="false">
        <appender-ref ref="API_STATISTICS_FILE"/>
    </logger>

</configuration>